{
  "name": "manim-blocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Kaoyusiliao",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node dev.js",
    "dev:electron": "node dev.js & electron . --dev",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "blockly": "^11.2.0",
    "highlight.js": "^11.10.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.manimblocks.app",
    "productName": "Manim Blocks",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
